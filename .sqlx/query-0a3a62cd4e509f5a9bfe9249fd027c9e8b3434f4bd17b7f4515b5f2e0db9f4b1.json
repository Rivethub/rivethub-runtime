{
  "db_name": "PostgreSQL",
  "query": "with picked as (select c.id from rh_conversations c where ($2::text[] is null or c.owner_user_id = any($2)) and (c.id = any($1) or ($1::uuid[] is null and not exists (select 1 from rh_session_trash tr where tr.session_key = c.session_key))) and ($3::timestamptz is null or c.updated_at >= $3) and ($4::timestamptz is null or c.updated_at < $4) and exists (select 1 from rh_messages x where x.conversation_id = c.id) order by c.updated_at desc, c.id limit $5) select c.id as conversation_id, c.session_key, c.agent, c.channel, c.title, c.settings as \"settings: sqlx::types::Json<JsonObject>\", c.node, c.owner_user_id, c.created_at as \"conversation_created_at!: jiff_sqlx::Timestamp\", c.updated_at as \"conversation_updated_at!: jiff_sqlx::Timestamp\", m.id::text as message_id, m.role as role_text, m.content, m.tool_name, m.tool_args::text as tool_args, m.tool_result, m.metadata::text as metadata, m.created_at as \"message_at!: jiff_sqlx::Timestamp\" from picked p join rh_conversations c on c.id = p.id join rh_messages m on m.conversation_id = c.id order by c.created_at, c.id, m.created_at, m.id",
