{
  "db_name": "PostgreSQL",
  "query": "select t.id::text as \"id!\", t.entity_type, t.entity_id::text as \"entity_id!\", t.key, t.value, t.display, t.source, t.state, t.confidence, t.proposed_by, CASE WHEN t.removal_state = 'suggested' THEN t.removal_reason ELSE t.reason END AS \"reason!\", t.decided_by, t.decided_at AS \"decided_at!: crate::time::OptionalTimestamp\", t.created_at AS \"created_at!: jiff_sqlx::Timestamp\", t.updated_at AS \"updated_at!: jiff_sqlx::Timestamp\", (t.removal_state = 'suggested') as \"is_removal?\", c.session_key as \"session_key?\", c.title as \"title?\", c.agent as \"agent?\", c.id::text as \"conversation_id?\", (select left(m.content, 120) from rh_messages m\n                  where m.conversation_id = c.id order by m.created_at asc limit 1) as excerpt from rh_tags t left join rh_summaries s on t.entity_type = 'summary' and s.id = t.entity_id left join rh_conversations c on (t.entity_type = 'conversation' and c.id = t.entity_id) OR c.id = s.conversation_id where t.state = 'suggested' or t.removal_state = 'suggested' order by t.created_at desc limit $1",
