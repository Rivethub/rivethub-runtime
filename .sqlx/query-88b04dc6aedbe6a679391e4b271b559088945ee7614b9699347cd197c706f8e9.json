{
  "db_name": "PostgreSQL",
  "query": "select c.session_key as key, c.id as conversation_id, c.title, c.agent, min(m.created_at) as \"first!\", max(m.created_at) as \"last!\", count(m.id) as \"messages!\", case when c.session_key like 'import:%' then c.settings -> 'origin' ->> 'author' end as imported_from from rh_conversations c join rh_messages m on m.conversation_id = c.id where c.owner_user_id = $1 and c.session_key = any($2) and not exists (select 1 from rh_session_trash tr where tr.session_key = c.session_key) group by c.id order by c.session_key, c.id",
